<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>User Dashboard</title>
    <link rel="stylesheet" href="/stylesheets/style.css" />
  </head>
  <body>
    <header>
      <h1>User Dashboard</h1>
      <nav>
        <a href="/">Home</a>
        <a href="/auth/logout">Logout</a>
      </nav>
    </header>

    <main>
      <section class="user-controls">
        <h2>Emergency Services</h2>
        <div class="controls-grid">
          <div class="control-card">
            <h3>Report Emergency</h3>
            <p>Submit a new emergency report</p>
            <a href="/emergency/create" class="btn">Report Emergency</a>
          </div>
          <div class="control-card">
            <h3>My Reports</h3>
            <p>View your submitted reports</p>
            <table border="1">
              <thead>
                <tr>
                  <th>User</th>
                  <th>Type</th>
                  <th>Description</th>
                  <th>Latitude</th>
                  <th>Longitude</th>
                  <th>Status</th>
                  <th>Responder</th>
                </tr>
              </thead>
              <tbody id="report-table-body">
                <!-- Data will be populated here -->
              </tbody>
            </table>
            <!-- <a href="/user/reports" class="btn">My Reports</a> -->
          </div>
          <div class="control-card">
            <h3>Safety Resources</h3>
            <p>Access safety information and resources</p>
            <a href="/user/resources" class="btn">Safety Resources</a>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <p>© 2025 Emergency Response System</p>
    </footer>
    <script>
      async function getUserReports(){
          try{
              const response = await fetch('/users/user/reports',{
                  method: 'GET',
                  headers: {
                      'Content-Type': 'application/json',
                  },
                  credentials:"include",
              });
              const reports = await response.json();
              const reportTableBody = document.getElementById('report-table-body');
              reportTableBody.innerHTML = '';
              reports.forEach((report)=>{
                const row = document.createElement('tr');
                row.innerHTML = `
                <td>${report.user.name}</td>
                <td>${report.type}</td>
                <td>${report.description}</td>
                <td>${report.latitude}</td>
                <td>${report.longitude}</td>
                <td>${report.status}</td>
                <td>${report.assignedResponder.name}</td>`;
                reportTableBody.appendChild(row);
              });
          }
      catch(err){
        console.log(err);
      }
    }
    getUserReports();
    </script>
  </body>
</html>
