<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Dashboard</title>
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
    />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <link rel="stylesheet" href="/stylesheets/style.css" />
    <style>
      body {
        background-color: #f8f9fa;
      }
      .navbar {
        margin-bottom: 20px;
      }
      .card {
        border-radius: 12px;
        box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.1);
      }
      .status-pending {
        background-color: #fff3cd;
      }
      .status-in-progress {
        background-color: #d1ecf1;
      }
      .status-resolved {
        background-color: #d4edda;
      }
      .table th, .table td {
        vertical-align: middle;
      }
    </style>
  </head>
  <body>
    <nav class="navbar navbar-expand-lg navbar-light bg-light">
      <div class="container">
        <a class="navbar-brand" href="#">Admin Dashboard</a>
        <div class="collapse navbar-collapse">
          <ul class="navbar-nav ms-auto">
            <li class="nav-item">
              <a class="nav-link btn btn-danger text-white" href="/auth/logout">Logout</a>
            </li>
          </ul>
        </div>
      </div>
    </nav>

    <!-- Hidden Bootstrap Toast Container to display notifications -->
    <div id="toastContainer" class="position-fixed top-0 end-0 p-3" style="z-index: 1050;">
      <!-- Toasts will be dynamically added here -->
  </div>

    <div class="container">
      <div class="row mb-4">
        <div class="col-md-4">
          <div class="card p-3">
            <h4>User Management</h4>
            <p>Manage all system users</p>
            <a href="/admin/users" class="btn btn-primary">Manage Users</a>
          </div>
        </div>
        <div class="col-md-4">
          <div class="card p-3">
            <h4>System Settings</h4>
            <p>Configure system parameters</p>
            <a href="/admin/settings" class="btn btn-secondary">Settings</a>
          </div>
        </div>
      </div>

      <div class="card p-3">
        <h4>Active Reports</h4>
        <div class="table-responsive">
          <table class="table table-striped table-bordered">
            <thead class="table-dark">
              <tr>
                <th>User</th>
                <th>Type</th>
                <th>Description</th>
                <th>Latitude</th>
                <th>Longitude</th>
                <th>Status</th>
                <th>Responder</th>
                <th>Created At</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody id="report-table-body">
              <!-- Data will be populated here -->
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <footer class="text-center py-3 mt-4 bg-light">
      <p>© 2025 Emergency Response System</p>
    </footer>
    <script>
      async function getReports() {
        try {
          const res = await fetch("/emergency/getall");
          const reports = await res.json();
          const reportTableBody = document.getElementById("report-table-body");
          if (reports.length===0){
            reportTableBody.innerHTML = `
                  <tr>
                    <td colspan="100%" style="text-align: center; font-size: 1.5rem; font-weight: bold; color: #6c757d; padding: 20px;">
                      No Active Reports
                    </td>
                  </tr>`;
                }
          else{
          reportTableBody.innerHTML = "";
          reports.forEach(async (report) => {
            const row = document.createElement("tr");
            row.innerHTML = `
              <td>${report.user.name}</td>
              <td>${report.type}</td>
              <td>${report.description}</td>
              <td>${report.latitude}</td>
              <td>${report.longitude}</td>
              <td class="status-${report.status.toLowerCase().replace(" ", "-")}">${report.status}</td>
              <td>
                ${
                  report.status === "Pending"
                    ? `
                    <select class="form-select responder-select" data-report-id="${report._id}">
                      <option value="">Select Responder</option>
                    </select>
                  `
                    : report.assignedResponder?.name || "Not Assigned"
                }
              </td>
              <td>${new Date(report.createdAt).toLocaleString()}</td>
              <td> 
              ${report.status === "Pending"?
                `<button class="btn btn-sm btn-success assign-btn" data-report-id="${report._id}">Assign</button>`
                : ""
              }
                <button class="btn btn-warning btn-sm" onclick="updateReportStatus('${report._id}', 'Resolved')">Resolved</button>
              </td>
            `;
            reportTableBody.appendChild(row);
            await populateResponders(report.type, report._id);
          });          
        }
        } catch (err) {
          console.log(err);
        }
      }

      async function updateReportStatus(reportId, status) {
    try {
        const response = await fetch(`/emergency/${reportId}/status`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ status })
        });
        if (response.ok) {
            alert('Status updated successfully');
        } else {
            throw new Error('Failed to update status');
        }
    } catch (err) {
        console.error('Error updating report status:', err);
        alert('Error updating status');
    }
}

      async function getResponders() {
        try {
          const res = await fetch("/users/admin/responders");
          return await res.json();
        } catch (err) {
          console.error("Error fetching responders:", err);
        }
      }

      async function populateResponders(reportType, reportId) {
        const responders = await getResponders();
        const selectElements = document.querySelectorAll(`.responder-select[data-report-id="${reportId}"]`);
        selectElements.forEach((select) => {
          select.innerHTML = '<option value="">Select Responder</option>';
          responders
           .filter((responder) => responder.responderType.toLowerCase() === reportType.toLowerCase())
          .forEach((responder) => {
            const option = document.createElement("option");
            option.value = responder._id;
            option.textContent = responder.name;
            select.appendChild(option);
          });
        });
      }

      document.addEventListener("click", async (e) => {
        if (e.target.classList.contains("assign-btn")) {
          const reportId = e.target.dataset.reportId;
          const select = document.querySelector(`.responder-select[data-report-id="${reportId}"]`);
          const responderId = select.value;
          if (!responderId) {
            alert("Please select a responder");
            return;
          }
          try {
            const response = await fetch(`/emergency/${reportId}/assign`, {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ responderId }),
            });
            if (response.ok) {
              alert("Responder assigned successfully");
              getReports();
            } else {
              throw new Error("Failed to assign responder");
            }
          } catch (err) {
            console.error("Error assigning responder:", err);
            alert("Error assigning responder");
          }
        }
      });
      getReports();
    </script>
    <script src="/socket.io/socket.io.js"></script>
    <script src="/javascripts/socket-client.js"></script>   
    <script src="/javascripts/toast.js"></script>
  </body>
</html>
