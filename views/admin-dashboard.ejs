<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <link rel="stylesheet" href="/stylesheets/style.css">
    <link rel="stylesheet" href="/stylesheets/admin.css">
    <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
    
</head>
<body>
  <!-- Hidden Bootstrap Toast Container to display notifications -->
  <div id="toastContainer" class="position-fixed top-0 end-0 p-3" style="z-index: 1050;">
    <!-- Toasts will be dynamically added here -->
</div>
    <div class="main-content">
        <nav class="navbar navbar-expand-lg navbar-light">
            <div class="container-fluid">
                <a class="navbar-brand">Admin Dashboard</a>
                <div class="ms-auto">
                    <a class="btn btn-dark" href="/auth/logout">Logout</a>
                </div>
            </div>
        </nav>

        <div class="container mt-4">
            <div class="card p-3">
                <h4>Active Reports</h4>
                <div class="form-group">
                  <label for="reportTypeFilter">Filters:</label>
                  <select id="reportTypeFilter" class="form-control" onchange="getReports(this.value)">
                    <option value="">All</option>
                    <option value="medical">Medical</option>
                    <option value="fire">Fire</option>
                    <option value="crime">Crime</option>
                    <option value="other">Other</option>
                  </select>
                </div>
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>User</th>
                                <th>Type</th>
                                <th>Description</th>
                                <th>Latitude</th>
                                <th>Longitude</th>
                                <th>Status</th>
                                <th>Responder</th>
                                <th>Created At</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="report-table-body">
                            <!-- Data will be populated here -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

      <!-- Map Modal -->
    <div class="modal fade" id="mapModal" tabindex="-1" aria-labelledby="mapModalLabel" aria-hidden="true">
      <div class="modal-dialog modal-lg">
          <div class="modal-content">
              <div class="modal-header">
                  <h5 class="modal-title" id="mapModalLabel">Emergency Location</h5>
                  <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
              </div>
              <div class="modal-body">
                  <div id="map"></div>
              </div>
          </div>
      </div>
  </div>

    <footer class="text-center py-3 mt-4 bg-light">
      <p>© 2025 Emergency Response System</p>
    </footer>
    <script>
      async function getReports(filter = "") {
        try {
          const res = await fetch("/emergency/getall");
          const reports = await res.json();
          const reportTableBody = document.getElementById("report-table-body");
          if (reports.length === 0) {
            reportTableBody.innerHTML = `
                  <tr>
                    <td colspan="100%" style="text-align: center; font-size: 1.5rem; font-weight: bold; color: #6c757d; padding: 20px;">
                      No Active Reports
                    </td>
                  </tr>`;
          } else {
            reportTableBody.innerHTML = "";
            reports.forEach(async (report) => {
              if (filter && report.type.toLowerCase() !== filter.toLowerCase()) {
                return;
              }
              const row = document.createElement("tr");
              row.innerHTML = `
                <td>${report.user?.name}</td>
                <td>${report.type}</td>
                <td>${report.description}</td>
                <td>${report.latitude}</td>
                <td>${report.longitude}</td>
                <td class="status-${report.status.toLowerCase().replace(" ", "-")}">${report.status}</td>
                <td>
                  ${
                    report.status === "Pending"
                      ? `
                        <select class="form-select responder-select" data-report-id="${report._id}">
                          <option value="">Select Responder</option>
                        </select>
                      `
                      : report.assignedResponder?.name || "Not Assigned"
                  }
                </td>
                <td>${new Date(report.createdAt).toLocaleString()}</td>
                <td>
                  ${report.status === "Pending" ?
                    `<button class="btn btn-sm btn-success assign-btn" data-report-id="${report._id}" >Assign</button>`
                    : ""
                  }
                  <button class="btn btn-warning btn-sm" onclick="updateReportStatus('${report._id}', 'Resolved')">Resolved</button>
                  <button class="btn btn-primary btn-sm" onclick="showMap(${report.latitude}, ${report.longitude}, '${report.type.toLowerCase()}','admin')">View Map</button>
                  <select id="notifyRange-${report._id}" class="form-select form-select-sm">
                  <option value="500">500m</option>
                  <option value="1000" selected>1km</option>
                  <option value="5000">5km</option>
              </select>
              <button class="btn btn-info btn-sm mt-1" onclick="notifyNearbyUsers('${report._id}')">Notify Others</button>
                </td>
              `;
              reportTableBody.appendChild(row);
              await populateResponders(report.type, report._id);
            });
          }
        } catch (err) {
          console.log(err);
        }
      }

      async function assignResponder(reportId) {
            const selectElement = document.querySelector(`.responder-select[data-report-id="${reportId}"]`);
            const responderId = selectElement.value;
            if (!responderId) {
                alert("Please select a responder.");
                return;
            }

            try {
                const response = await fetch(`/emergency/${reportId}/assign`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ responderId })
                });
                if (response.ok) {
                    alert('Responder assigned successfully');
                    getReports(document.getElementById("reportTypeFilter").value); // Reload reports after assigning responder
                } else {
                    throw new Error('Failed to assign responder');
                }
            } catch (err) {
                console.error('Error assigning responder:', err);
                alert('Error assigning responder');
            }
        }

      async function updateReportStatus(reportId, status) {
        try {
          const response = await fetch(`/emergency/${reportId}/status`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ status })
            });
            if (response.ok) {
              alert('Report status updated successfully');
              getReports(document.getElementById("reportTypeFilter").value); // Reload reports after updating status
              } else {
                throw new Error('Failed to update status');
              }
            } catch (err) {
              console.error('Error updating status:', err);
              alert('Error updating status');
              }
              }

      async function getResponders() {
        try {
          const res = await fetch("/users/admin/responders");
          return await res.json();
        } catch (err) {
          console.error("Error fetching responders:", err);
        }
      }

      async function populateResponders(reportType, reportId) {
        const responders = await getResponders();
        const selectElements = document.querySelectorAll(`.responder-select[data-report-id="${reportId}"]`);
        selectElements.forEach((select) => {
          select.innerHTML = '<option value="">Select Responder</option>';
          responders
           .filter((responder) => responder.responderType.toLowerCase() === reportType.toLowerCase())
          .forEach((responder) => {
            const option = document.createElement("option");
            option.value = responder._id;
            option.textContent = responder.name;
            select.appendChild(option);
          });
        });
      }

async function notifyNearbyUsers(reportId) {
    const range = document.getElementById(`notifyRange-${reportId}`).value;

    try {
        const response = await fetch(`/emergency/${reportId}/notify-nearby`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ range: parseInt(range) })
        });

        const data = await response.json();

        if (response.ok) {
            showToast(`Nearby users within ${range}m have been notified!`, "success");
        } else {
            showToast(`Error: ${data.message}`, "danger");
        }
    } catch (err) {
        console.error("Error notifying users:", err);
        showToast("Failed to notify users.", "danger");
    }
}

document.addEventListener("click", async (event) => {
    if (event.target.classList.contains("assign-btn")) {
        const reportId = event.target.getAttribute("data-report-id");
        await assignResponder(reportId);
    }
});

      getReports();
    </script>
    <script src="/socket.io/socket.io.js"></script>
    <script src="/javascripts/socket-client.js"></script>
    <script src="/javascripts/toast.js"></script>
    <script src="/javascripts/map.js"></script>
  </body>
</html>
