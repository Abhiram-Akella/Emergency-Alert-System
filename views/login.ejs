<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>
    <div class="login-container">
        <h1 class="text-center">Login</h1>
        <% if (typeof error !== 'undefined' && error) { %>
            <div class="error-message"><%= error %></div>
        <% } %>
        <form id="login-form" action="/auth/login" method="POST" class="mt-4">
            <div class="form-group">
                <label for="email">Email:</label>
                <input type="email" id="email" name="email" class="form-control" required>
            </div>
            <div class="form-group">
                <label for="password">Password:</label>
                <input type="password" id="password" name="password" class="form-control" required>
            </div>
            <input type="hidden" id="latitude" name="latitude">
            <input type="hidden" id="longitude" name="longitude">
            <button type="submit" class="btn btn-primary">Login</button>
        </form>
        <p class="mt-3">Don't have an account? <a href="/auth/register">Register here</a></p>
    </div>
    <script src="/javascripts/getLocation.js"></script>
    <script>
        window.onload = function () {
            const urlParams = new URLSearchParams(window.location.search);
            if (urlParams.has('error')) {
            alert("Invalid credentials. Please try again.");
            }
        };
        document.addEventListener("DOMContentLoaded", function () {
            const loginForm = document.getElementById("login-form")

            loginForm.addEventListener("submit", function (event) {
                if (!latInput.value || !lngInput.value) {
                    event.preventDefault(); // Stop form submission
                    console.log("Fetching location...");
                    getLocation(() => {
                        console.log("Submitting form with location:", latInput.value, lngInput.value);
                        loginForm.submit(); // Submit after location is set
                    });
                }
            });
        });
    </script>
</body>
</html>
