<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Responder Dashboard</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <style>
        .status-pending { background-color: #fff3cd; }
        .status-in-progress { background-color: #d1ecf1; }
        .status-resolved { background-color: #d4edda; }
    </style>
</head>
<body>
    <!-- Hidden Bootstrap Toast Container to display notifications -->
    <div id="toastContainer" class="position-fixed top-0 end-0 p-3" style="z-index: 1050;">
        <!-- Toasts will be dynamically added here -->
    </div>
    <header class="bg-primary text-white text-center py-3">
        <h1>Responder Dashboard</h1>
    </header>
    
    <nav class="navbar navbar-expand-lg navbar-light bg-light px-3">
        <a class="navbar-brand" href="/">Home</a>
        <div class="collapse navbar-collapse">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item">
                    <a class="nav-link" href="/auth/logout">Logout</a>
                </li>
            </ul>
        </div>
    </nav>
    
    <main class="container my-4">
        <section class="mb-4">
            <h2 class="text-center">Unresolved Reports</h2>
            <div class="card">
                <div class="card-body table-responsive" style="max-height:400px;overflow-y:auto;">
                    <table class="table table-striped table-bordered">
                        <thead class="table-dark">
                            <tr>
                                <th>Type</th>
                                <th>Description</th>
                                <th>Location</th>
                                <th>Status</th>
                                <th>Created At</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="unresolved-reports">
                            <!-- Unresolved reports will be populated here -->
                        </tbody>
                    </table>
                </div>
            </div>
        </section>
        
        <section class="mb-4">
            <h2 class="text-center">My Assigned Reports</h2>
            <div class="card">
                <div class="card-body table-responsive" style="max-height:400px;overflow-y:auto;">
                    <table class="table table-striped table-bordered">
                        <thead class="table-dark">
                            <tr>
                                <th>Type</th>
                                <th>Description</th>
                                <th>Location</th>
                                <th>Status</th>
                                <th>Created At</th>
                            </tr>
                        </thead>
                        <tbody id="assigned-reports">
                            <!-- Assigned reports will be populated here -->
                        </tbody>
                    </table>
                </div>
            </div>
        </section>
        
        <section class="text-center">
            <h2>Response Tools</h2>
            <a href="/responder/tools" class="btn btn-primary">Access Response Tools</a>
        </section>
    </main>
    
    <script>
        async function getAssignedReports() {
            try {
                const res = await fetch('/emergency/assigned');
                const { resolvedReports, unresolvedReports } = await res.json();
                
                const assignedTableBody = document.getElementById('assigned-reports');
                const unresolvedTableBody = document.getElementById('unresolved-reports');

                assignedTableBody.innerHTML = '';
                unresolvedTableBody.innerHTML = '';

                resolvedReports.forEach(report => {
                    const row = document.createElement('tr');
                    row.innerHTML = `
                        <td>${report.type}</td>
                        <td>${report.description}</td>
                        <td>${report.latitude}, ${report.longitude}</td>
                        <td class="status-${report.status.toLowerCase().replace(' ', '-')}">${report.status}</td>
                        <td>${new Date(report.createdAt).toLocaleString()}</td>
                    `;
                    assignedTableBody.appendChild(row);
                });

                unresolvedReports.forEach(report => {
                    const row = document.createElement('tr');
                    row.innerHTML = `
                        <td>${report.type}</td>
                        <td>${report.description}</td>
                        <td>${report.latitude}, ${report.longitude}</td>
                        <td class="status-${report.status.toLowerCase().replace(' ', '-')}">${report.status}</td>
                        <td>${new Date(report.createdAt).toLocaleString()}</td>
                        <td>
                            <button class="btn btn-warning btn-sm" onclick="updateReportStatus('${report._id}', 'In Progress')">Start</button>
                            <button class="btn btn-warning btn-sm" onclick="updateReportStatus('${report._id}', 'Resolved')">Resolved</button>
                            </td>
                    `;
                    unresolvedTableBody.appendChild(row);
                });
            } catch (err) {
                console.error('Error fetching assigned reports:', err);
            }
        }

        async function updateReportStatus(reportId, status) {
            try {
                const response = await fetch(`/emergency/${reportId}/status`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ status })
                });
                if (response.ok) {
                    alert('Status updated successfully');
                    getAssignedReports();
                } else {
                    throw new Error('Failed to update status');
                }
            } catch (err) {
                console.error('Error updating report status:', err);
                alert('Error updating status');
            }
        }
        
        getAssignedReports();
    </script>
    <script src="/socket.io/socket.io.js"></script>
    <script src="/javascripts/socket-client.js"></script> 
    <script src="/javascripts/toast.js"></script>
    
    <footer class="text-center py-3 bg-light mt-4">
        <p>&copy; 2025 Emergency Response System</p>
    </footer>
</body>
</html>
